@model Depom.Application.User.DTOs.LoginDto
@{
    ViewData["Title"] = "Giris";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giris - Depom</title>
    <link rel="stylesheet" href="~/css/remixicon.css" />
    <link rel="stylesheet" href="~/css/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/depom.css" />
</head>
<body>

    <div class="auth-page">
        <div class="auth-card">

            <div class="text-center mb-4">
                <div class="auth-logo">De<span>pom</span></div>
                <p class="text-depom-muted mt-1" style="font-size:13px;">Envanter Yonetim Sistemi</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:13px;">
                    <i class="ri-error-warning-line me-1"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Kullanici Adi</label>
                    <div class="position-relative">
                        <input asp-for="Username" class="form-control ps-5" placeholder="kullanici.adi" autocomplete="off" />
                        <i class="ri-user-3-line position-absolute top-50 translate-middle-y ms-3"
                           style="color: var(--depom-muted); font-size:16px; left:0; pointer-events:none;"></i>
                    </div>
                    <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Sifre</label>
                    <div class="position-relative">
                        <input asp-for="Password" type="password" class="form-control ps-5" placeholder="••••••••" />
                        <i class="ri-lock-2-line position-absolute top-50 translate-middle-y ms-3"
                           style="color: var(--depom-muted); font-size:16px; left:0; pointer-events:none;"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <button type="submit" class="btn-depom-primary w-100 text-center" style="border-radius:8px; padding:11px;">
                    <i class="ri-login-box-line me-2"></i>Giris Yap
                </button>
            </form>

            <p class="text-center text-depom-muted mt-4 mb-0" style="font-size:12px;">
                Depom &copy; 2026
            </p>
        </div>
    </div>

    <script src="~/js/lib/jquery-3.7.1.min.js"></script>
    <script src="~/js/lib/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>