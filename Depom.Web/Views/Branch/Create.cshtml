@model Depom.Application.Branch.DTOs.BranchCreateDto
@{
    ViewData["Title"] = "Yeni Sube";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Yeni Sube</h5>
        <p class="page-subtitle">Sisteme yeni sube ekle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;"></div>

                    <div class="mb-3">
                        <label class="form-label">Sube Adi</label>
                        <input asp-for="Name" class="form-control" placeholder="Sube adi" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Adres</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Sube adresi"></textarea>
                        <span asp-validation-for="Address" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Telefon</label>
                        <input asp-for="Phone" class="form-control" placeholder="0212 000 00 00" />
                        <span asp-validation-for="Phone" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-depom-primary">
                            <i class="ri-save-line me-1"></i> Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}