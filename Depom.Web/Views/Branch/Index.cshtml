@model List<Depom.Application.Branch.DTOs.BranchListDto>
@{ ViewData["Title"] = "Subeler"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Subeler</h4>
    @if (User.IsInRole("SystemAdmin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni Sube</a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sube Adi</th>
                    <th>Telefon</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Phone ?? "-")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                        @if (User.IsInRole("SystemAdmin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Duzenle</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Silinsin mi?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
