@using Depom.Application.Transfer.DTOs
@using Depom.Application.Stock.DTOs
@{
    ViewData["Title"] = "Dashboard";
    var recentTransfers = ViewBag.RecentTransfers as List<TransferListDto> ?? new List<TransferListDto>();
    var lowStockItems = ViewBag.LowStockItems as List<StockItemDto> ?? new List<StockItemDto>();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Dashboard</h5>
        <p class="page-subtitle">Genel envanter durumu</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-icon primary">
                <i class="ri-building-2-line"></i>
            </div>
            <div>
                <div class="stat-card-label">Subeler</div>
                <div class="stat-card-value">@(ViewBag.BranchCount ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-icon accent">
                <i class="ri-box-3-line"></i>
            </div>
            <div>
                <div class="stat-card-label">Urunler</div>
                <div class="stat-card-value">@(ViewBag.ProductCount ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-icon success">
                <i class="ri-stack-line"></i>
            </div>
            <div>
                <div class="stat-card-label">Stok Kalemleri</div>
                <div class="stat-card-value">@(ViewBag.StockCount ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-icon info">
                <i class="ri-swap-box-line"></i>
            </div>
            <div>
                <div class="stat-card-label">Aktif Transferler</div>
                <div class="stat-card-value">@(ViewBag.ActiveTransferCount ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>Son Transferler</span>
                <a href="/Transfer/Index" class="text-depom-accent" style="font-size:13px;">
                    Tumunu Gor <i class="ri-arrow-right-line"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Urun</th>
                            <th>Kaynak</th>
                            <th>Hedef</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in recentTransfers)
                        {
                            var (badgeClass, badgeLabel) = t.Status.ToString() switch
                            {
                                "Draft" => ("badge-depom-primary", "Taslak"),
                                "Pending" => ("badge-depom-warning", "Beklemede"),
                                "Approved" => ("badge-depom-info", "Onaylandi"),
                                "InTransit" => ("badge-depom-accent", "Yolda"),
                                "Received" => ("badge-depom-success", "Alindi"),
                                "Cancelled" => ("badge-depom-danger", "Iptal"),
                                "Rejected" => ("badge-depom-danger", "Reddedildi"),
                                _ => ("badge-depom-primary", t.Status.ToString())
                            };
                            <tr>
                                <td class="text-depom-muted" style="font-size:13px;">#@t.Id</td>
                                <td class="fw-semibold" style="font-size:13px;">@t.ProductName</td>
                                <td class="text-depom-muted" style="font-size:13px;">@t.SourceBranchName</td>
                                <td class="text-depom-muted" style="font-size:13px;">@t.TargetBranchName</td>
                                <td><span class="@badgeClass">@badgeLabel</span></td>
                                <td class="text-depom-muted" style="font-size:13px;">
                                    @t.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </td>
                            </tr>
                        }
                        @if (!recentTransfers.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-depom-muted py-4">
                                    Henuz transfer bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>Dusuk Stok Uyarisi</span>
                <i class="ri-alert-line text-depom-muted"></i>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Urun</th>
                            <th>Sube</th>
                            <th>Miktar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in lowStockItems)
                        {
                            <tr>
                                <td style="font-size:13px;">@s.ProductName</td>
                                <td style="font-size:13px;" class="text-depom-muted">@s.BranchName</td>
                                <td><span class="badge-depom-danger">@s.Quantity</span></td>
                            </tr>
                        }
                        @if (!lowStockItems.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-depom-muted py-4">
                                    Dusuk stok yok.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>