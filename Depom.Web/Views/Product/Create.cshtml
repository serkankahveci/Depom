@model Depom.Application.Product.DTOs.ProductCreateDto
@{
    ViewData["Title"] = "Yeni Urun";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Yeni Urun</h5>
        <p class="page-subtitle">Sisteme yeni urun ekle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Urun Adi</label>
                            <input asp-for="Name" class="form-control" placeholder="Urun adi" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Stok Kodu (SKU)</label>
                            <input asp-for="SKU" class="form-control" placeholder="URN-001" />
                            <span asp-validation-for="SKU" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Barkod</label>
                            <input asp-for="Barcode" class="form-control" placeholder="1234567890" />
                            <span asp-validation-for="Barcode" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Kategori</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Kategori Secin --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fiyat (₺)</label>
                            <input asp-for="Price" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Dusuk Stok Esigi</label>
                            <input asp-for="LowStockThreshold" class="form-control" placeholder="5" />
                            <span asp-validation-for="LowStockThreshold" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Aciklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Urun aciklamasi"></textarea>
                            <span asp-validation-for="Description" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-12">
                            <div class="d-flex gap-2 mt-2">
                                <button type="submit" class="btn-depom-primary">
                                    <i class="ri-save-line me-1"></i> Kaydet
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}