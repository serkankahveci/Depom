@model Depom.Application.Product.DTOs.ProductUpdateDto
@{ ViewData["Title"] = "Urun Duzenle"; }

<h4 class="mb-4">Urun Duzenle</h4>
<div class="card border-0 shadow-sm" style="max-width:640px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label">Urun Adi</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SKU" class="form-label">SKU</label>
                    <input asp-for="SKU" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Barcode" class="form-label">Barkod</label>
                    <input asp-for="Barcode" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label">Fiyat (TL)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-6">
                    <label asp-for="LowStockThreshold" class="form-label">Dusuk Stok Esigi</label>
                    <input asp-for="LowStockThreshold" class="form-control" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Kategori</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">Durum</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<Depom.Domain.Enums.ProductStatus>()" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Aciklama</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Guncelle</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
            </div>
        </form>
    </div>
</div>
