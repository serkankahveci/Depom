@model List<Depom.Application.Product.DTOs.ProductListDto>
@{ ViewData["Title"] = "Urunler"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Urunler</h4>
    @if (User.IsInRole("SystemAdmin") || User.IsInRole("BranchManager"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni Urun</a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Urun Adi</th>
                    <th>SKU</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><code>@item.SKU</code></td>
                    <td>@item.CategoryName</td>
                    <td>@item.Price.ToString("N2") TL</td>
                    <td><span class="badge bg-@(item.Status == Depom.Domain.Enums.ProductStatus.Active ? "success" : "secondary")">@item.Status</span></td>
                    <td class="text-end">
                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                        @if (User.IsInRole("SystemAdmin") || User.IsInRole("BranchManager"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Duzenle</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Silinsin mi?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
