@model Depom.Application.Stock.DTOs.StockAdjustDto
@{
    ViewData["Title"] = "Stok Duzelt";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Stok Duzelt</h5>
        <p class="page-subtitle">Stok miktarini manuel guncelle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Adjust" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;"></div>

                    <div class="mb-3">
                        <label class="form-label">Urun</label>
                        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                            <option value="">-- Urun Secin --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sube</label>
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">-- Sube Secin --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Yeni Miktar</label>
                        <input asp-for="NewQuantity" class="form-control" placeholder="0" min="0" />
                        <span asp-validation-for="NewQuantity" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Not <span class="text-depom-muted" style="font-size:12px;">(opsiyonel)</span></label>
                        <textarea asp-for="Note" class="form-control" rows="2" placeholder="Duzeltme sebebi..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-depom-primary">
                            <i class="ri-save-line me-1"></i> Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}