@model Depom.Application.Stock.DTOs.StockAdjustDto
@{ ViewData["Title"] = "Stok Duzeltme"; }

<h4 class="mb-4">Stok Duzeltme</h4>
<div class="card border-0 shadow-sm" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Adjust" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="BranchId" class="form-label">Sube</label>
                <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                    <option value="">-- Secin --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">Urun</label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- Secin --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="NewQuantity" class="form-label">Yeni Miktar</label>
                <input asp-for="NewQuantity" class="form-control" type="number" min="0" />
            </div>
            <div class="mb-3">
                <label asp-for="Note" class="form-label">Duzeltme Nedeni</label>
                <input asp-for="Note" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Duzelt</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
            </div>
        </form>
    </div>
</div>
