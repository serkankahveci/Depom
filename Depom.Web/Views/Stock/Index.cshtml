@model List<Depom.Application.Stock.DTOs.StockItemDto>
@{
    ViewData["Title"] = "Stok";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Stok Durumu</h5>
        <p class="page-subtitle">Sube bazli stok listesi</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Movement" class="btn-depom-accent">
            <i class="ri-arrow-left-right-line me-1"></i> Giris / Cikis
        </a>
        <a asp-action="Adjust" class="btn btn-outline-secondary btn-sm">
            <i class="ri-equalizer-line me-1"></i> Duzelt
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Urun</th>
                    <th>Stok Kodu</th>
                    <th>Sube</th>
                    <th>Miktar</th>
                    <th>Rezerve</th>
                    <th>Kullanilabilir</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td class="text-depom-muted" style="font-size:13px;">@item.SKU</td>
                        <td class="text-depom-muted" style="font-size:13px;">@item.BranchName</td>
                        <td>@item.Quantity</td>
                        <td class="text-depom-muted">@item.ReservedQuantity</td>
                        <td class="fw-semibold">@item.AvailableQuantity</td>
                        <td>
                            @if (item.IsLowStock)
                            {
                                <span class="badge-depom-danger">
                                    <i class="ri-alert-line me-1"></i>Dusuk Stok
                                </span>
                            }
                            else
                            {
                                <span class="badge-depom-success">Normal</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-depom-muted py-4">
                            Stok kaydi bulunamadi.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>