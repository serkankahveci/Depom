@model List<Depom.Application.Stock.DTOs.StockMovementListDto>
@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Stok Hareketleri</h5>
        <p class="page-subtitle">Giris, cikis ve duzeltme gecmisi</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Urun</th>
                    <th>Hareket Tipi</th>
                    <th>Miktar</th>
                    <th>Not</th>
                    <th>Islem Yapan</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td>
                            @switch (item.Type.ToString())
                            {
                                case "In":
                                    <span class="badge-depom-success">
                                        <i class="ri-arrow-down-line me-1"></i>Giris
                                    </span>
                                    break;
                                case "Out":
                                    <span class="badge-depom-danger">
                                        <i class="ri-arrow-up-line me-1"></i>Cikis
                                    </span>
                                    break;
                                case "Adjust":
                                    <span class="badge-depom-warning">
                                        <i class="ri-equalizer-line me-1"></i>Duzeltme
                                    </span>
                                    break;
                                case "Transfer":
                                    <span class="badge-depom-info">
                                        <i class="ri-swap-line me-1"></i>Transfer
                                    </span>
                                    break;
                                default:
                                    <span class="badge-depom-primary">@item.Type</span>
                                    break;
                            }
                        </td>
                        <td class="fw-semibold">@item.Quantity</td>
                        <td class="text-depom-muted" style="font-size:13px;">@(item.Note ?? "-")</td>
                        <td class="text-depom-muted" style="font-size:13px;">@item.CreatedByUserName</td>
                        <td class="text-depom-muted" style="font-size:13px;">
                            @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-depom-muted py-4">
                            Henuz hareket kaydi bulunamadi.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>