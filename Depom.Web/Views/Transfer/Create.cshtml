@model Depom.Application.Transfer.DTOs.TransferCreateDto
@{ ViewData["Title"] = "Yeni Transfer"; }

<h4 class="mb-4">Yeni Transfer Talebi</h4>
<div class="card border-0 shadow-sm" style="max-width:560px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">Urun</label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- Secin --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="SourceBranchId" class="form-label">Kaynak Sube</label>
                <select asp-for="SourceBranchId" asp-items="ViewBag.Branches" class="form-select">
                    <option value="">-- Secin --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="TargetBranchId" class="form-label">Hedef Sube</label>
                <select asp-for="TargetBranchId" asp-items="ViewBag.Branches" class="form-select">
                    <option value="">-- Secin --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Miktar</label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
            </div>
            <div class="mb-3">
                <label asp-for="Note" class="form-label">Not</label>
                <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Olustur (Taslak)</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
            </div>
        </form>
    </div>
</div>
