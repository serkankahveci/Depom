@model Depom.Application.Transfer.DTOs.TransferDetailDto
@{
    ViewData["Title"] = "Transfer Detayi";
    var statusStr = Model.Status.ToString();
    var (cls, lbl) = statusStr switch
    {
        "Draft" => ("badge-depom-primary", "Taslak"),
        "Pending" => ("badge-depom-warning", "Beklemede"),
        "Approved" => ("badge-depom-info", "Onaylandi"),
        "InTransit" => ("badge-depom-accent", "Yolda"),
        "Received" => ("badge-depom-success", "Alindi"),
        "Cancelled" => ("badge-depom-danger", "Iptal"),
        "Rejected" => ("badge-depom-danger", "Reddedildi"),
        _ => ("badge-depom-primary", statusStr)
    };
    bool isAdminOrManager = User.IsInRole("SystemAdmin") || User.IsInRole("BranchManager");
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Transfer #@Model.Id</h5>
        <p class="page-subtitle"><span class="@cls">@lbl</span></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">

        @if (statusStr == "Draft" && isAdminOrManager)
        {
            <form asp-action="Submit" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@Model.Id" />
                <button type="submit" class="btn-depom-primary">
                    <i class="ri-send-plane-line me-1"></i> Gonder
                </button>
            </form>
        }

        @if (statusStr == "Pending" && isAdminOrManager)
        {
            <form asp-action="Approve" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@Model.Id" />
                <button type="submit" class="btn-depom-primary">
                    <i class="ri-checkbox-circle-line me-1"></i> Onayla
                </button>
            </form>
        }

        @if (statusStr == "Approved" && isAdminOrManager)
        {
            <form asp-action="Ship" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@Model.Id" />
                <button type="submit" class="btn-depom-accent">
                    <i class="ri-truck-line me-1"></i> Sevk Et
                </button>
            </form>
        }

        @if (statusStr == "InTransit" && isAdminOrManager)
        {
            <form asp-action="Receive" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@Model.Id" />
                <button type="submit" class="btn-depom-primary">
                    <i class="ri-checkbox-multiple-line me-1"></i> Teslim Al
                </button>
            </form>
        }

        @if (statusStr == "Draft" || statusStr == "Pending")
        {
            <form asp-action="Cancel" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TransferId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="ri-close-line me-1"></i> Iptal Et
                </button>
            </form>
        }

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="ri-arrow-left-line me-1"></i> Geri
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Transfer Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Urun</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.ProductName</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Kaynak Sube</dt>
                    <dd class="col-sm-7">@Model.SourceBranchName</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Hedef Sube</dt>
                    <dd class="col-sm-7">@Model.TargetBranchName</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Miktar</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.Quantity</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Not</dt>
                    <dd class="col-sm-7">@(Model.Note ?? "-")</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Olusturan</dt>
                    <dd class="col-sm-7">@Model.CreatedByUserName</dd>

                    <dt class="col-sm-5 text-depom-muted" style="font-size:13px;">Tarih</dt>
                    <dd class="col-sm-7" style="font-size:13px;">
                        @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Durum Gecmisi</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Eski Durum</th>
                            <th>Yeni Durum</th>
                            <th>Islem Yapan</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td style="font-size:13px;">@log.OldStatus</td>
                                <td style="font-size:13px;">@log.NewStatus</td>
                                <td style="font-size:13px;" class="text-depom-muted">@log.ActingUserName</td>
                                <td style="font-size:13px;" class="text-depom-muted">
                                    @log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                            </tr>
                        }
                        @if (!Model.Logs.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-depom-muted py-3">
                                    Henuz log bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>