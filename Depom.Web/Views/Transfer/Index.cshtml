@model List<Depom.Application.Transfer.DTOs.TransferListDto>
@{
    ViewData["Title"] = "Transferler";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Transferler</h5>
        <p class="page-subtitle">Sube transfer listesi</p>
    </div>
    <a asp-action="Create" class="btn-depom-primary">
        <i class="ri-add-line me-1"></i> Yeni Transfer
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Urun</th>
                    <th>Kaynak Sube</th>
                    <th>Hedef Sube</th>
                    <th>Miktar</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th class="text-end">Islemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-depom-muted" style="font-size:13px;">#@item.Id</td>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td class="text-depom-muted" style="font-size:13px;">@item.SourceBranchName</td>
                        <td class="text-depom-muted" style="font-size:13px;">@item.TargetBranchName</td>
                        <td>@item.Quantity</td>
                        <td>
                            @{
                                var (cls, lbl) = item.Status.ToString() switch
                                {
                                    "Draft" => ("badge-depom-primary", "Taslak"),
                                    "Pending" => ("badge-depom-warning", "Beklemede"),
                                    "Approved" => ("badge-depom-info", "Onaylandi"),
                                    "InTransit" => ("badge-depom-accent", "Yolda"),
                                    "Received" => ("badge-depom-success", "Alindi"),
                                    "Cancelled" => ("badge-depom-danger", "Iptal"),
                                    "Rejected" => ("badge-depom-danger", "Reddedildi"),
                                    _ => ("badge-depom-primary", item.Status.ToString())
                                };
                            }
                            <span class="@cls">@lbl</span>
                        </td>
                        <td class="text-depom-muted" style="font-size:13px;">
                            @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                        </td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="ri-eye-line"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-depom-muted py-4">
                            Henuz transfer bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>