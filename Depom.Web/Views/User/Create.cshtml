@model Depom.Application.User.DTOs.UserCreateDto
@{
    ViewData["Title"] = "Yeni Kullanici";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Yeni Kullanici</h5>
        <p class="page-subtitle">Sisteme yeni kullanici ekle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;"></div>

                    <div class="mb-3">
                        <label class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Ahmet Yilmaz" />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kullanici Adi</label>
                        <input asp-for="Username" class="form-control" placeholder="ahmet.yilmaz" autocomplete="off" />
                        <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sifre</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <div class="text-depom-muted" style="font-size:12px; margin-top:4px;">En az 6 karakter.</div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
                            <option value="">-- Rol Secin --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sube <span class="text-depom-muted" style="font-size:12px;">(opsiyonel)</span></label>
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">-- Sube Yok --</option>
                        </select>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label" style="font-size:14px;">Aktif</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-depom-primary">
                            <i class="ri-save-line me-1"></i> Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}