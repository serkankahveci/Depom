@model Depom.Application.User.DTOs.UserDetailDto
@{
    ViewData["Title"] = "Kullanıcı Detayı";
    var badgeClass = Model.Role switch
    {
        Depom.Domain.Enums.AppRole.SystemAdmin => "bg-danger",
        Depom.Domain.Enums.AppRole.BranchManager => "bg-primary",
        Depom.Domain.Enums.AppRole.StockClerk => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">👤 @Model.FullName</h5>
                <span class="badge @badgeClass">@Model.RoleDisplay</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Kullanıcı Adı</dt>
                    <dd class="col-sm-8">@Model.Username</dd>

                    <dt class="col-sm-4">Şube</dt>
                    <dd class="col-sm-8">@(Model.BranchName ?? "—")</dd>

                    <dt class="col-sm-4">Durum</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pasif</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Kayıt Tarihi</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Son Giriş</dt>
                    <dd class="col-sm-8">
                        @(Model.LastLoginAt.HasValue
                                                ? Model.LastLoginAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                : "Henüz giriş yapılmadı")
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
            </div>
        </div>
    </div>
</div>