@model Depom.Application.User.DTOs.UserUpdateDto
@{
    ViewData["Title"] = "Kullanici Duzenle";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h5 class="page-title">Kullanici Duzenle</h5>
        <p class="page-subtitle">Kullanici bilgilerini guncelle</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ri-arrow-left-line me-1"></i> Geri
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="font-size:13px;"></div>

                    <div class="mb-3">
                        <label class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kullanici Adi</label>
                        <input asp-for="Username" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Yeni Sifre
                            <span class="text-depom-muted" style="font-size:12px;">(bos birakilirsa degismez)</span>
                        </label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" placeholder="******" />
                        <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select"></select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sube</label>
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">-- Sube Yok --</option>
                        </select>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" style="font-size:14px;">Aktif</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-depom-primary">
                            <i class="ri-save-line me-1"></i> Guncelle
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Iptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}